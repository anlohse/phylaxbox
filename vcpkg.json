{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "phylaxbox",
  "version": "0.1.0",
  "builtin-baseline": "77df67cfff9c12ccfdb52284e07c87c75092f723",
  "dependencies": [
    "libsodium",
    "zlib",
    "nlohmann-json"
  ],
  "features": {
    "desktop": {
      "description": "Desktop application (webview UI, TLS transport)",
      "dependencies": [
        "openssl",
        {
          "name": "cpp-httplib",
          "default-features": false,
          "features": [
            "openssl"
          ]
        }
      ]
    },
    "tests": {
      "description": "Unit tests",
      "dependencies": [
        "gtest"
      ]
    }
  }
}

{
  "manifest_version": 3,
  "name": "PhylaxBox",
  "description": "Fill passwords from your PhylaxBox vault. Requires the PhylaxBox desktop app.",
  "version": "0.0.0",
  "permissions": ["nativeMessaging"],
  "action": {
    "default_title": "PhylaxBox",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png" }
  },
  "icons": { "16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png" }
}
